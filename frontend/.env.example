# ---- Public values (safe in the browser). Copy to .env.local and fill in. ----
# Supabase Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: only if the API runs on a different origin (default: same origin /api)
VITE_API_BASE_URL=

# ---- Server-only values. NEVER prefix with VITE_. Locally put them in .env.server.local
# (gitignored); in production set them in Vercel → Settings → Environment Variables. ----
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY default to the VITE_ values above.
# ALLOWED_ORIGINS=https://other-allowed-origin.example
# ANTHROPIC_API_KEY=         (Phase 8 — Claude extraction)
# STT_API_KEY=               (Phase 8 — speech-to-text provider, chosen by bake-off)
# SUPABASE_SERVICE_ROLE_KEY= (admin features only)
